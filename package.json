{
  "name": "agent-reputation-api",
  "description": "Time-decayed, sybil-damped reputation scores for autonomous agents: signed attestations, a zero-dependency HTTP API, persistence, and a CLI",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "rep": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node dist/cli.js demo",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "ai-agents",
    "reputation",
    "trust",
    "attestations",
    "multi-agent",
    "sybil-resistance",
    "time-decay",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/agent-reputation-api.git"
  },
  "bugs": {
    "url": "https://github.com/Retsumdk/agent-reputation-api/issues"
  },
  "homepage": "https://github.com/Retsumdk/agent-reputation-api#readme",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.3.0"
  }
}
